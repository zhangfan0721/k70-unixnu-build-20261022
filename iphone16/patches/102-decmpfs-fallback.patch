--- a/bsd/kern/decmpfs.c
+++ b/bsd/kern/decmpfs.c
@@ -1713,4 +1713,10 @@
 	if (!compression_type_valid(vp, hdr)) {
 		err = ENOTSUP;
+		/* k70: no decompressor is registered for this compression type, which
+		 * would otherwise fail the whole read with ENOTSUP. The data fork of
+		 * such a file may still hold the real payload (verified offline for
+		 * /sbin/launchd: a plain 64-bit Mach-O, not a decmpfs stream). Tell HFS
+		 * to fall back to its normal read path so it re-reads the fork as data. */
+		*is_compressed = 0;
 		goto out;
 	}
