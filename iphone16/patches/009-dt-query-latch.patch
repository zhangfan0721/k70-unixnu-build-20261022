--- a/pexpert/gen/device_tree.c
+++ b/pexpert/gen/device_tree.c
@@ -326,8 +326,23 @@
 	return kError;
 }
 
-int
-SecureDTLookupEntry(const DTEntry searchPoint, const char *pathName, DTEntry *foundEntry)
+
+/*
+ * K70: name the exact device-tree query that failed. AppleImage4's manifest
+ * policy lookup fails with a bare status today; this prints the node, the key
+ * and the caller so the -v boot log identifies the failing component.
+ */
+extern int printf(const char *, ...);
+static void
+k70_dt_note(int kind, const char *node, const char *key, int rc, uintptr_t caller)
+{
+	printf("K70DT kind=%d rc=%d caller=%p node=%s key=%s\n",
+	    kind, rc, (void *)caller, node ? node : "-", key ? key : "-");
+}
+#define K70_DT_CALLER ((uintptr_t)__builtin_return_address(0))
+
+static int
+k70_dt_lookup_entry(const DTEntry searchPoint, const char *pathName, DTEntry *foundEntry)
 {
 	DTEntryNameBuf  buf;
 	RealDTEntry     cur;
@@ -505,8 +520,13 @@
 int
 SecureDTGetProperty(const DTEntry entry, const char *propertyName, void const **propertyValue, unsigned int *propertySize)
 {
-	return SecureDTGetPropertyInternal(entry, propertyName, propertyValue, propertySize,
+	int rc = SecureDTGetPropertyInternal(entry, propertyName, propertyValue, propertySize,
 	           (vm_offset_t)DTRootNode, (vm_size_t)((uintptr_t)DTEnd - (uintptr_t)DTRootNode));
+
+	if (rc != kSuccess) {
+		k70_dt_note(2, NULL, propertyName, rc, K70_DT_CALLER);
+	}
+	return rc;
 }
 
 int
@@ -552,3 +572,14 @@
 	iter->currentIndex = 0;
 	return kSuccess;
 }
+
+int
+SecureDTLookupEntry(const DTEntry searchPoint, const char *pathName, DTEntry *foundEntry)
+{
+	int rc = k70_dt_lookup_entry(searchPoint, pathName, foundEntry);
+
+	if (rc != kSuccess) {
+		k70_dt_note(1, pathName, NULL, rc, K70_DT_CALLER);
+	}
+	return rc;
+}
