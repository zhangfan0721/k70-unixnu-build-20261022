+/* An optional demand backend: a device with mdFetch set serves reads by
+ * calling it instead of copying from a static base. Writes stay refused.
+ * The callback returns an errno; the strategy reports it and completes the
+ * buf, so no request ever falls through to the static base path. */
+typedef int (*mdfetch_t)(int devid, uint64_t offset, void *dst, size_t length);
+
 struct mdev {
 	uint64_t        mdBase;         /* base page number (pages are assumed to be 4K). Multiply by 4096 to find actual address */
 	uint32_t        mdSize;         /* size in pages (pages are assumed to be 4K). Multiply by 4096 to find actual size. */
 	int                     mdFlags;        /* flags */
 	int                     mdSecsize;      /* sector size */
+	mdfetch_t	mdFetch;	/* demand read backend, or NULL */
 	int                     mdBDev;         /* Block device number */
 	int                     mdCDev;         /* Character device number */
 	void *          mdbdevb;
@@ -178,6 +185,7 @@
 
 static int      mdevioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p, int is_char);
 dev_t           mdevadd(int devid, uint64_t base, unsigned int size, int phys);
+dev_t           mdevadd_fetch(int devid, unsigned int size, mdfetch_t fetch);
 dev_t           mdevlookup(int devid);
 void            mdevremoveall(void);
 int             mdevgetrange(int devid, uint64_t *base, uint64_t *size);
@@ -303,6 +311,21 @@
 	if (buf_map(bp, (caddr_t *)&vaddr)) {
 		panic("ramstrategy: buf_map failed");
 	}
+	if (mdev[devid].mdFetch != NULL) {
+		int ferror = 0;
+		if (!(buf_flags(bp) & B_READ)) {
+			ferror = EROFS;
+		} else {
+			ferror = mdev[devid].mdFetch(devid, blkoff, (void *)vaddr,
+			    (size_t)buf_count(bp));
+		}
+		if (ferror != 0) {
+			buf_seterror(bp, ferror);
+			buf_setresid(bp, buf_count(bp));
+		}
+		buf_biodone(bp);
+		return;
+	}
 
 	fvaddr = (mdev[devid].mdBase << 12) + blkoff;           /* Point to offset into ram disk */
 
@@ -712,6 +735,79 @@
 	return mdev[devid].mdBDev;
 }
 
+/*
+ * Register a device whose reads are produced on demand by fetch. It has no
+ * static base range, so no overlap check applies; size is in 4 KiB pages and
+ * the device is read-only by construction.
+ */
+dev_t
+mdevadd_fetch(int devid, unsigned int size, mdfetch_t fetch)
+{
+	int i;
+
+	if (size == 0 || fetch == NULL) {
+		return -1;
+	}
+	if (devid < 0) {
+		devid = -1;
+		for (i = 0; i < NB_MAX_MDEVICES; i++) {
+			if (!(mdev[i].mdFlags & mdInited)) {
+				devid = i;
+				break;
+			}
+		}
+		if (devid < 0) {
+			printf("mdevadd_fetch: no free memory device slot\n");
+			return -1;
+		}
+	} else {
+		if (devid >= NB_MAX_MDEVICES || (mdev[devid].mdFlags & mdInited)) {
+			printf("mdevadd_fetch: slot %d unavailable\n", devid);
+			return -1;
+		}
+	}
+
+	if (mdevBMajor < 0) {
+		mdevBMajor = bdevsw_add(-1, &mdevbdevsw);
+		if (mdevBMajor < 0) {
+			printf("mdevadd_fetch: bdevsw_add returned %d\n", mdevBMajor);
+			return -1;
+		}
+	}
+	if (mdevCMajor < 0) {
+		mdevCMajor = cdevsw_add_with_bdev(-1, &mdevcdevsw, mdevBMajor);
+		if (mdevCMajor < 0) {
+			printf("mdevadd_fetch: cdevsw_add returned %d\n", mdevCMajor);
+			return -1;
+		}
+	}
+
+	mdev[devid].mdBDev = makedev(mdevBMajor, devid);
+	mdev[devid].mdbdevb = devfs_make_node(mdev[devid].mdBDev, DEVFS_BLOCK,
+		UID_ROOT, GID_OPERATOR, 0600, "md%d", devid);
+	if (mdev[devid].mdbdevb == NULL) {
+		printf("mdevadd_fetch: devfs_make_node for block failed!\n");
+		return -1;
+	}
+	mdev[devid].mdCDev = makedev(mdevCMajor, devid);
+	mdev[devid].mdcdevb = devfs_make_node(mdev[devid].mdCDev, DEVFS_CHAR,
+		UID_ROOT, GID_OPERATOR, 0600, "rmd%d", devid);
+	if (mdev[devid].mdcdevb == NULL) {
+		printf("mdevadd_fetch: devfs_make_node for character failed!\n");
+		return -1;
+	}
+
+	mdev[devid].mdBase = 0;
+	mdev[devid].mdSize = size;
+	mdev[devid].mdSecsize = DEV_BSIZE;
+	mdev[devid].mdFetch = fetch;
+	mdev[devid].mdFlags |= mdInited | mdRO;
+	printf("Added demand device md%x/rmd%x (%08X/%08X) for %llu bytes\n",
+		devid, devid, mdev[devid].mdBDev, mdev[devid].mdCDev,
+		(unsigned long long)size << 12);
+	return mdev[devid].mdBDev;
+}
+
 
 dev_t
 mdevlookup(int devid)
